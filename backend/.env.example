# ---------------------------------------------------------------------------
# Standalone Lead Capture API — copy to .env and fill in
# ---------------------------------------------------------------------------

# Database. Default is a local SQLite file (leads.db) — zero setup.
# Production me Postgres daalo (Supabase / Render Postgres):
# DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./leads.db

APP_ENV=development

# Frontend ka URL (exact, no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Admin login (apne hisaab se badlo) -----------------------------------
ADMIN_EMAIL=admin@vyomacre.com
ADMIN_PASSWORD=change-me-please
SECRET_KEY=koi-lamba-random-string
TOKEN_TTL_HOURS=12

# --- Notifications (optional) ---------------------------------------------
# Tum + team leader, comma se
NOTIFY_EMAIL_TO=you@gmail.com,teamleader@gmail.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=VyomAcre

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

APP_BASE_URL=http://localhost:5173
